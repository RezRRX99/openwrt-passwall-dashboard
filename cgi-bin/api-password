#!/bin/sh
# api-password: changes the router root password. Requires a session.
#
# POST /cgi-bin/api-password   {"current":"...","new":"..."}
#
# The current password is checked again, so an unattended open session cannot change it.
# This password also unlocks SSH and LuCI.

. /usr/lib/dash/dash-lib.sh
dash_require_session
dash_read_body

current=$(dash_field current)
new=$(dash_field new)

[ "${#new}" -ge 8 ] && [ "${#new}" -le 128 ] || dash_fail bad_password
case "$new" in
	*"
"*) dash_fail bad_password ;;
esac

# jshn builds the JSON so that quotes in the password cannot break it.
json_init
json_add_string username root
json_add_string password "$current"
json_add_int timeout 5
request=$(json_dump)
session=$(ubus call session login "$request" 2>/dev/null | jsonfilter -e '@.ubus_rpc_session' 2>/dev/null)
[ -n "$session" ] || dash_fail wrong_password '403 Forbidden'
ubus call session destroy "{\"ubus_rpc_session\":\"$session\"}" >/dev/null 2>&1

# Sent on stdin, so the password never appears in a process list.
printf '%s\n%s\n' "$new" "$new" | passwd root >/dev/null 2>&1 || dash_fail password_failed '500 Internal Server Error'

# Everything logged in with the old password ends here, this session included.
ubus call session list 2>/dev/null | sed -n 's/.*"ubus_rpc_session": *"\([0-9a-f]\{32\}\)".*/\1/p' | while read -r sid; do
	[ "$sid" = "$DASH_ANON_SESSION" ] || ubus call session destroy "{\"ubus_rpc_session\":\"$sid\"}" >/dev/null 2>&1
done

json_init
json_add_boolean ok 1
dash_send
